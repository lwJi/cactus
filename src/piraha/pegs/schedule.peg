# The grammar for the schedule.ccl file
skipper = \b([\ \t\n\r\b]|{-ccomment}|\#[^\n]*|\\[\r\n])*

any = [^]
name = (?i:[a-zA-Z_][a-zA-Z0-9_]*\b)
expr = {name}|{quote}|{num}
# TODO: Should this be a * or a ?
vname = {name}( :: {name})*( \[ {expr} \]|)
uname = {name}( :: {name})?
quote = "(\\{any}|[^"])*"
ccomment = /\*((?!\*/){-any})*\*/
num = [+\-]?[0-9]+(\.[0-9]+)?
string = {name}|{quote}
term = {num}|{name}( \( ({expr} (, {quote} )*)?\) )?
par = \b(?i:as|at|in|while|if|before|after|while)\b
pararg = ({uname}|\( {uname}( ,? {uname} )* \))
assign = {name} = {num}

boolpar = \( {boolexpr} \)
args = ({expr}( , {expr})*|)
fun = {name} \( {args} \)
boolstar = \* {name}
boolneg = \! {boolexpr}
boolterm = (?i:{boolneg}
         | {boolstar}
         | {boolpar}
         | {fun}
         | {name} )
         
boolop = (&&|\|\|)
boolcmp = (>=|<=|==|!=|<|>)
boolexpr = {boolterm} ({boolop} {boolexpr} )+
     | {term} {boolcmp} {term} | {boolterm}

lang = (?i:lang(uage|) : {name})
group = (?i:group)
nogroup =
prepositions = ({preposition} )*
preposition = {par} {pararg}
sync = (?i:sync) : {uname}( , {uname}|{-spacing}{uname})*
spacing = ([ \t]|\\\r?\n)+
optname = [a-zA-Z0-9-]+
options = (?i:options?) : {optname}( , {optname}|{-spacing}{optname})*
triggers = (?i:triggers?) : {vname}( , {vname}|{-spacing}{vname})*
reads = (?i:reads) : {qrname}( , {qrname}|{-spacing}{qrname})*
writes = (?i:writes) : {qrname}( , {qrname}|{-spacing}{qrname})*
invalidates = (?i:invalidates) : {qrname}( , {qrname}|{-spacing}{qrname})*
qrname = {vname}( \( {region} \)|)
region = (?i:everywhere|interiorwithboundary|interior|all|in|boundary|scalar)
tags = (?i:tags) : {assign}( , {assign}|{-spacing}{assign})*
# A conditional READS:/WRITES:/INVALIDATES: clause, usable inside a
# SCHEDULE block body so those clauses can vary by parameter without
# duplicating the whole SCHEDULE statement. First pass: a single
# if/else, no chaining ("else if") and no nesting - see notes.md.
# NOTE: the spaces around each `|` below are load-bearing, not style. In
# this .peg format, a skip is compiled in wherever whitespace appears in
# the rule's own source text between elements - it is not auto-inserted
# based on which alternative comes first. Writing this compactly as
# `({reads}|{writes}|{invalidates})*` (no spaces around `|`) gives only
# `reads` a leading skip and leaves `writes`/`invalidates` with none,
# because only `reads` sits right after the group's own opening
# `( ` (a real space in the source); matching `reads` then `writes`
# then loses the intervening whitespace and misparses as a syntax
# error at the second clause. Every existing multi-alternative OR in
# this file (`boolterm`, `schedule`'s own body, ...) already writes a
# space after each `|`, which is what actually makes them work - this
# rule just needs to follow the same convention. See notes.md.
rdwrblock = \{ ( {reads} | {writes} | {invalidates} )* \}
# Chained "else if" is supported by making rdwrif directly recursive in
# its else position, exactly like the top-level ifbody rule does. A
# SCHEDULE body may also contain several independent rdwrifs (the
# schedule body alternation below is a repetition), which ScheduleParser.pl
# expands as the cartesian product of their branches.
rdwrif = (?i:
  if \( {boolexpr} \) {rdwrblock} ( {else} {rdwrif} | {else} {rdwrblock} | )
  )
schedule = (?i:
  schedule ({group}|{nogroup}) {name} {prepositions} \{
    ( {storage}
        | {lang}
        | {sync}
        | {options}
        | {triggers}
        | {reads}
        | {writes}
        | {invalidates}
        | {tags}
        | {rdwrif}
    )*
 \} {quote}
 )
else = else
ifbody = {block} ({else} {if}|{else} {block}|)
if = (?i:
  if \( {boolexpr} \) {ifbody}
  )
storage = (?i:storage: {vname}( , {vname}|{-spacing}{vname})* )
block = \{ (({statement}|{block}) )* \} | {statement}

statement = ({schedule} |{if} |{storage} )
sched = ^ ({statement} |{block} )*$
