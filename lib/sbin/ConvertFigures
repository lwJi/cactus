#! /bin/sh

if [ ! -n "$1" ]
then
  figpath="."
else
 figpath=$1
fi

files=`find ${figpath} -type f -name "*.pdf"`

# if possible use ebb to compute the bounding boxes only rather than full
# pdf2ps conversion

if ebb 2>/dev/null --version ; then
  if [ -n "${files}" ]; then
    echo "  Computing bounding boxes for figures"
  fi

  for i in $files; do
    xbbfilename=`echo $i | sed s/.pdf$/.xbb/`

    if [ "$i" != "documentation.pdf" ]; then
      echo "   " `basename $i` " -> " `basename $xbbfilename`
      ebb -x -O $i >$xbbfilename
    fi
  done
else
  if [ -n "${files}" ]; then
    echo "  Converting figures to postscript"
  fi

  for i in $files; do
    epsfilename=`echo $i | sed s/.pdf$/.eps/`

    if [ "$i" != "documentation.pdf" ] && [ ! -e $epsfilename ]; then
      echo "   " `basename $i` " -> " `basename $epsfilename`
      pdf2ps $i $epsfilename
    fi
  done
fi
