  printf %s "(cached) " >&6
else case e in #(
  e) ac_save_LDFLAGS="$LDFLAGS"
  LDFLAGS="-Wl,--whole-archive -Wl,--no-whole-archive"
  cat confdefs.h - <<_ACEOF >conftest.$ac_ext
/* end confdefs.h.  */

