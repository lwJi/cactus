printf "%s\n" "$cctk_cv_c_inline" >&6; }
case "$cctk_cv_c_inline" in
  inline)
      printf "%s\n" "#define CCTK_C_INLINE inline" >>confdefs.h

      printf "%s\n" "#define HAVE_CCTK_C_INLINE 1" >>confdefs.h

      printf "%s\n" "#define HAVE_STANDARD_CCTK_C_INLINE 1" >>confdefs.h
 ;;
  no) printf "%s\n" "#define CCTK_C_INLINE /**/" >>confdefs.h

      printf "%s\n" "#define CCTK_C_INLINE /**/" >>confdefs.h
 ;;
  *)  printf "%s\n" "#define CCTK_C_INLINE $cctk_cv_c_inline" >>confdefs.h

      printf "%s\n" "#define HAVE_CCTK_C_INLINE 1" >>confdefs.h
 ;;
esac

{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for C static inline" >&5
printf %s "checking for C static inline... " >&6; }
if test ${cctk_cv_c_static_inline+y}
then :
  printf %s "(cached) " >&6
else case e in #(
  e) cctk_cv_c_static_inline=no
for ac_kw in 'static inline' 'static __inline__' 'static __inline' static; do
  cat > conftest.$ac_ext <<EOF
#line 9989 "configure"
#include "confdefs.h"

int main(void) {
;} $ac_kw int ifoo(){} int foo(){ifoo();
; return 0; }
EOF
cat > conftest2.$ac_ext <<EOF
#line 9997 "configure"
#include "confdefs.h"

int main2() {
;} $ac_kw int ifoo(){} int foo2(){ifoo();
; return 0; }
EOF
if { { eval echo "\"\$as_me\":${as_lineno-$LINENO}: \"$ac_link conftest2.$ac_ext\""; } >&5
  (eval $ac_link conftest2.$ac_ext) 2>&5
  ac_status=$?
  printf "%s\n" "$as_me:${as_lineno-$LINENO}: \$? = $ac_status" >&5
  test $ac_status = 0; } && test -s conftest${ac_exeext}; then
  rm -rf conftest*
  cctk_cv_c_static_inline=$ac_kw; break
else
  printf "%s\n" "$as_me: failed program was:" >&5
sed 's/^/| /' conftest.$ac_ext >&5

fi
rm -f conftest*
done
 ;;
esac
fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $cctk_cv_c_static_inline" >&5
printf "%s\n" "$cctk_cv_c_static_inline" >&6; }
case "$cctk_cv_c_static_inline" in
  no) printf "%s\n" "#define CCTK_C_STATIC_INLINE static" >>confdefs.h
