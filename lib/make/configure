  printf "%s\n" "#define CCTK_DEBUG 1" >>confdefs.h

  case "$DEBUG" in
     memory)
       printf "%s\n" "#define CCTK_TRACEMEMORY 1" >>confdefs.h

       ;;
     flags|yes)
       DEBUG_FLAGS='yes'
       ;;
     defines)
       printf "%s\n" "#define DEBUG 1" >>confdefs.h

       ;;
     all)
      printf "%s\n" "#define CCTK_TRACEMEMORY 1" >>confdefs.h

      DEBUG_FLAGS='yes'
      ;;
    *)
      as_fn_error $? "Didn't recognize setting of DEBUG=\"$DEBUG\"" "$LINENO" 5
      ;;
   esac
fi


