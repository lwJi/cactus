ac_link='$CXX -o conftest$ac_exeext $CXXFLAGS $CPPFLAGS $LDFLAGS conftest.$ac_ext $LIBS >&5'
ac_compiler_gnu=$ac_cv_cxx_compiler_gnu

cctk_cv_cxx_func=no
for ac_func in "std::$cctk_func" "$cctk_func" "::$cctk_func"; do
for ac_nargs in 1 2; do
  case $ac_nargs in
    1) ac_args='(1.0)'; ac_argsf='(1.0f)' ;;
    2) ac_args='(1.0, 1.0)'; ac_argsf='(1.0f, 1.0f)' ;;
  esac
  cat confdefs.h - <<_ACEOF >conftest.$ac_ext
/* end confdefs.h.  */

/* See note in cctk_Math.h regarding these include statements */
#include <cmath>
#include <math.h>

int
main (void)
{

{
  $ac_func $ac_argsf;
  $ac_func $ac_args;
}
using namespace std;
{
  $ac_func $ac_argsf;
  $ac_func $ac_args;
}

  ;
  return 0;
}
_ACEOF
if ac_fn_cxx_try_compile "$LINENO"
then :
  cctk_cv_cxx_func="$ac_func"; break 2
fi
rm -f core conftest.err conftest.$ac_objext conftest.beam conftest.$ac_ext
done
done
ac_ext=c
ac_cpp='$CPP $CPPFLAGS'
ac_compile='$CC -c $CFLAGS $CPPFLAGS conftest.$ac_ext >&5'
ac_link='$CC -o conftest$ac_exeext $CFLAGS $CPPFLAGS $LDFLAGS conftest.$ac_ext $LIBS >&5'
ac_compiler_gnu=$ac_cv_c_compiler_gnu

eval cctk_cv_cxx_$cctk_func=\$cctk_cv_cxx_func
 ;;
esac
fi

{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $cctk_cv_cxx_func" >&5
printf "%s\n" "$cctk_cv_cxx_func" >&6; }
case "$cctk_cv_cxx_func" in
  no) : ;;
  *)  printf "%s\n" "#define CCTK_CXX_$cctk_tr_func $cctk_cv_cxx_func" >>confdefs.h

      printf "%s\n" "#define HAVE_CCTK_CXX_$cctk_tr_func 1" >>confdefs.h
 ;;
esac


{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for C _Pragma" >&5
printf %s "checking for C _Pragma... " >&6; }
if test ${cctk_cv_have_c__Pragma+y}
then :
  printf %s "(cached) " >&6
else case e in #(
  e) cctk_cv_have_c__Pragma=no
cat confdefs.h - <<_ACEOF >conftest.$ac_ext
/* end confdefs.h.  */

#define LOOP(i) _Pragma("omp for") for (int i=0; i<10; ++i)

int
main (void)
{

  int s=0;
#pragma omp parallel reduction(+: s)
  LOOP(i) {
    s+=i;
  }

  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_compile "$LINENO"
then :
  cctk_cv_have_c__Pragma=yes
else case e in #(
  e) cctk_cv_have_c__Pragma=no ;;
esac
fi
rm -f core conftest.err conftest.$ac_objext conftest.beam conftest.$ac_ext
 ;;
esac
fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $cctk_cv_have_c__Pragma" >&5
printf "%s\n" "$cctk_cv_have_c__Pragma" >&6; }
if test "$cctk_cv_have_c__Pragma" = "yes" ; then
