# See if there's a null device, and what it's called

if test "x$cross_compiling" = 'xyes'; then
  if test -z "$NULL_DEVICE" ; then
     { printf "%s\n" "$as_me:${as_lineno-$LINENO}: WARNING: Cross-compiling - no value set for location of null device please set NULL_DEVICE" >&5
printf "%s\n" "$as_me: WARNING: Cross-compiling - no value set for location of null device please set NULL_DEVICE" >&2;}
     { printf "%s\n" "$as_me:${as_lineno-$LINENO}: WARNING: Defaulting to /dev/null" >&5
printf "%s\n" "$as_me: WARNING: Defaulting to /dev/null" >&2;}
     NULL_DEVICE='/dev/null'
  fi
  eval "cctk_cv_nulldevice=$NULL_DEVICE"
  printf "%s\n" "#define NULL_DEVICE \"$cctk_cv_nulldevice\"" >>confdefs.h

else
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking for the null device" >&5
printf %s "checking for the null device... " >&6; }
if test ${cctk_cv_nulldevice+y}
then :
  printf %s "(cached) " >&6
else case e in #(
  e)
if test -d /dev ; then
  eval "cctk_cv_nulldevice=/dev/null"
else
  cat > NUL <<EOF
test
EOF
  if eval "`cat NUL > /dev/null 2>/dev/null`" ; then
    eval "cctk_cv_nulldevice=NUL"
  fi
fi
 ;;
esac
fi

if eval "test -n \"$cctk_cv_nulldevice\"" ; then
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $cctk_cv_nulldevice" >&5
printf "%s\n" "$cctk_cv_nulldevice" >&6; }
  printf "%s\n" "#define NULL_DEVICE \"$cctk_cv_nulldevice\"" >>confdefs.h

else
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: not found" >&5
printf "%s\n" "not found" >&6; }
fi

fi

