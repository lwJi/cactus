  case $ac_config_target in
    "cctk_Config.h") CONFIG_HEADERS="$CONFIG_HEADERS cctk_Config.h" ;;
    "default-1") CONFIG_COMMANDS="$CONFIG_COMMANDS default-1" ;;
    "make.config.defn") CONFIG_FILES="$CONFIG_FILES make.config.defn" ;;
    "make.config.deps") CONFIG_FILES="$CONFIG_FILES make.config.deps" ;;
    "make.config.rules") CONFIG_FILES="$CONFIG_FILES make.config.rules" ;;

  *) as_fn_error $? "invalid argument: '$ac_config_target'" "$LINENO" 5;;
  esac
