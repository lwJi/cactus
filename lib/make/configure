#include <stddef.h>
int
main (void)
{

  FILE *fh=fopen("conftestval", "w");
  if(!fh) return 1;
  if(fprintf(fh, "%d\n", (int)sizeof(double)) < 0) return 1;
  if(fclose(fh)) return 1;

  ;
  return 0;
}
_ACEOF
if ac_fn_c_try_run "$LINENO"
then :
  ac_cv_sizeof_double=`cat conftestval`
else case e in #(
  e) as_fn_error $? "Could not determine size of type double even though I am not cross-compiling." "$LINENO" 5 ;;
esac
fi
rm -f core *.core core.conftest.* gmon.out bb.out conftest$ac_exeext \
  conftest.$ac_objext conftest.beam conftest.$ac_ext ;;
esac
fi

fi
 ;;
esac
fi
