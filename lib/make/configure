  OPTIMISE=`echo $OPTIMISE | tr '[:upper:]' '[:lower:]'`
  OPTIMIZE=`echo $OPTIMIZE | tr '[:upper:]' '[:lower:]'`

  if test -n "$OPTIMIZE" -a "$OPTIMISE" != "$OPTIMIZE" ; then
    as_fn_error $? "OPTIMISE=\"$OPTIMISE\" is inconsistent with OPTIMIZE=\"$OPTIMIZE\"!" "$LINENO" 5
  fi
  if test "$OPTIMISE" != 'yes' -a "$OPTIMISE" != 'no' ; then
    as_fn_error $? "Didn't recognize setting of OPTIMISE=\"$OPTIMISE\" (should be either \"yes\" or \"no\")" "$LINENO" 5
  fi
  OPTIMISE_MODE=$OPTIMISE
elif test -n "$OPTIMIZE"; then

  OPTIMISE=`echo $OPTIMIZE | tr '[:upper:]' '[:lower:]'`

  if test "$OPTIMISE" != 'yes' -a "$OPTIMISE" != 'no' ; then
    as_fn_error $? "Didn't recognize setting of OPTIMIZE=\"$OPTIMIZE\" (should be either \"yes\" or \"no\")" "$LINENO" 5
  fi
  OPTIMISE_MODE=$OPTIMISE
fi


