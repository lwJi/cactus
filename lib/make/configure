# See if there's a null device, and what it's called

if test "x$cross_compiling" = 'xyes'; then
  if test -z "$NULL_DEVICE" ; then
     echo "configure: warning: Cross-compiling - no value set for location of null device please set NULL_DEVICE" 1>&2
     echo "configure: warning: Defaulting to /dev/null" 1>&2
     NULL_DEVICE='/dev/null'
  fi
  eval "cctk_cv_nulldevice=$NULL_DEVICE"
  cat >> confdefs.h <<EOF
#define NULL_DEVICE "$cctk_cv_nulldevice"
EOF

else
  echo $ac_n "checking for the null device""... $ac_c" 1>&6
echo "configure:2560: checking for the null device" >&5
if eval "test \"`echo '$''{'cctk_cv_nulldevice'+set}'`\" = set"; then
  echo $ac_n "(cached) $ac_c" 1>&6
else
  
if test -d /dev ; then
  eval "cctk_cv_nulldevice=/dev/null"
else
  cat > NUL <<EOF
test
EOF
  if eval "`cat NUL > /dev/null 2>/dev/null`" ; then
    eval "cctk_cv_nulldevice=NUL"
  fi
fi

fi

if eval "test -n \"$cctk_cv_nulldevice\"" ; then
  echo "$ac_t""$cctk_cv_nulldevice" 1>&6
  cat >> confdefs.h <<EOF
#define NULL_DEVICE "$cctk_cv_nulldevice"
EOF

else
  echo "$ac_t"""not found"" 1>&6
fi

fi

