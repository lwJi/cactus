# How to link in all object files from an archive


if test  -z "$BEGIN_WHOLE_ARCHIVE_FLAGS" &&
   test -z "$END_WHOLE_ARCHIVE_FLAGS" ; then
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking whether linker supports --whole-archive" >&5
printf %s "checking whether linker supports --whole-archive... " >&6; }
  if test ${cctk_cv_have_whole_archive+y}
