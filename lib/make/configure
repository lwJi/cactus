    as_fn_error $? "Didn't recognise setting of DISABLE_REAL16=\"$DISABLE_REAL16\"; should be either \"yes\" or \"no\" or \"\" (empty)" "$LINENO" 5
fi

if test -n "$CCTK_REAL16_TYPE" -a \( "x$F90" = "x$F90_NONE" -o \( "x$cctk_cv_have_fortran_real16" = 'xyes' -a "x$cctk_cv_have_fortran_complex32" = 'xyes' -a "x$DISABLE_REAL16" != 'xyes' \) \); then
  printf "%s\n" "#define CCTK_REAL16_TYPE $CCTK_REAL16_TYPE" >>confdefs.h

  printf "%s\n" "#define HAVE_CCTK_REAL16 1" >>confdefs.h

  printf "%s\n" "#define CCTK_REAL16_KIND $REAL16_KIND" >>confdefs.h

  printf "%s\n" "#define CCTK_COMPLEX32_KIND $COMPLEX32_KIND" >>confdefs.h

fi

if test -n "$CCTK_REAL8_TYPE" -a \( "x$F90" = "x$F90_NONE" -o \( "x$cctk_cv_have_fortran_real8" = 'xyes' -a "x$cctk_cv_have_fortran_complex16" = 'xyes' \) \); then
  printf "%s\n" "#define CCTK_REAL8_TYPE $CCTK_REAL8_TYPE" >>confdefs.h

  printf "%s\n" "#define HAVE_CCTK_REAL8 1" >>confdefs.h

fi

if test -n "$CCTK_REAL4_TYPE" -a \( "x$F90" = "x$F90_NONE" -o \( "x$cctk_cv_have_fortran_real4" = 'xyes' -a "x$cctk_cv_have_fortran_complex8" = 'xyes' \) \); then
  printf "%s\n" "#define CCTK_REAL4_TYPE $CCTK_REAL4_TYPE" >>confdefs.h

  printf "%s\n" "#define HAVE_CCTK_REAL4 1" >>confdefs.h

fi


# Define the default floating point and integer precisions
case "x$REAL_PRECISION" in
  'x16')
    printf "%s\n" "#define CCTK_REAL_PRECISION_16 1" >>confdefs.h
 ;;
  'x8')
    printf "%s\n" "#define CCTK_REAL_PRECISION_8 1" >>confdefs.h
 ;;
  'x4')
    printf "%s\n" "#define CCTK_REAL_PRECISION_4 1" >>confdefs.h
 ;;
  *)
    printf "%s\n" "#define CCTK_REAL_PRECISION_8 1" >>confdefs.h
 ;;
esac

case "x$INTEGER_PRECISION" in
  'x8')
    printf "%s\n" "#define CCTK_INTEGER_PRECISION_8 1" >>confdefs.h
 ;;
  'x4')
    printf "%s\n" "#define CCTK_INTEGER_PRECISION_4 1" >>confdefs.h
 ;;
  'x2')
    printf "%s\n" "#define CCTK_INTEGER_PRECISION_2 1" >>confdefs.h
 ;;
  *)
    printf "%s\n" "#define CCTK_INTEGER_PRECISION_4 1" >>confdefs.h
 ;;
esac

